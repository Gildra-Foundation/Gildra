{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--isolated",
        "--output-dir",
        "${CLAUDE_PROJECT_DIR:-.}/.artifacts/playwright"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "valyro": {
      "command": "npx",
      "args": [
        "-y",
        "valyro-cli@0.1.0",
        "mcp",
        "--cwd",
        "${CLAUDE_PROJECT_DIR:-.}"
      ]
    }
  }
}
