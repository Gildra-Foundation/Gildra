POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
REDIS_PASSWORD=change-me-redis
PAYLOAD_SECRET=change-me-with-at-least-32-random-characters
PAYLOAD_DB_PUSH=false
INDEXNOW_KEY=00000000000000000000000000000000
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin
ADMIN_SESSION_TTL=24h
SENTRY_GO_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Cloudflare API credentials. Prefer a scoped API token in production.
CLOUDFLARE_API_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=

# ParsesUnix providers. Keep real values only in the untracked production .env.
# Paid providers are still disabled unless explicitly listed in a run config.
SCRAPE_DO_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_BROWSER_ZONE=
BRIGHTDATA_CPM_USD=
ZENROWS_API_KEY=
ZENROWS_BASE_CPM_USD=
ZYTE_API_KEY=
ZYTE_HTTP_MAX_USD=
ZYTE_BROWSER_MAX_USD=
ZYTE_CAPTURE_MAX_USD=
FIRECRAWL_API_KEY=

# Production images are set by CI/CD.
WEB_IMAGE=ghcr.io/gildra-foundation/gildra-web:latest
API_IMAGE=ghcr.io/gildra-foundation/gildra-api:latest
CMS_IMAGE=ghcr.io/gildra-foundation/gildra-cms:latest
SCRAPER_IMAGE=ghcr.io/gildra-foundation/gildra-scraper:latest
