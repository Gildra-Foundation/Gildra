POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
REDIS_PASSWORD=change-me-redis
PAYLOAD_SECRET=change-me-with-at-least-32-random-characters
PAYLOAD_DB_PUSH=false
INDEXNOW_KEY=00000000000000000000000000000000
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin
ADMIN_SESSION_TTL=24h
# Optional observability. Leave empty to keep Sentry disabled.
SENTRY_GO_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Public catalog delivery is fail-closed in production. Keep production in
# enforce mode; report is only for local inspection while source rights are
# being reviewed.
CATALOG_PUBLICATION_MODE=enforce
CATALOG_PUBLICATION_ENVIRONMENT=production
# Private mode requires the administrator session for REST, GraphQL and media.
# It also disables shared/public response caching for the catalog.
CATALOG_ACCESS_MODE=private
# This installation intentionally accepts same-host loss risk and requires a
# fresh encrypted local backup plus isolated restore proof before publication.
CATALOG_RECOVERY_POLICY=verified_same_host
CATALOG_MEDIA_DIRECTORY=/var/lib/gildra/catalog-media
CATALOG_MEDIA_PUBLIC_BASE_URL=https://api.gildra.net

# Pinned bilingual Genshin source checkout used only by the explicit
# operations-profile importer. The production release currently tracks
# genshin-db v5.2.12 / Genshin 6.7.
GENSHIN_SOURCE_DIRECTORY=./.artifacts/genshin-db-source
GENSHIN_SOURCE_REVISION=67f563f693343ea2ec8e8121f1245dcb010a8809
GENSHIN_GAME_VERSION=6.7
GENSHIN_SUPPLEMENTAL_DIRECTORY=./.artifacts/genshin-supplemental
GENSHIN_ALTERNATE_MEDIA_DIRECTORY=./.artifacts/genshin-alt-media
GENSHIN_ALTERNATE_MEDIA_BASE_URL=https://raw.githubusercontent.com/PathOfGenshin/resources/015a2493b5672b28576ab78ffbcffde2ea0c9844/resources/gi/Sprite
GENSHIN_MEDIA_WORKERS=12

# Battle.net Game Data API. Create a client at develop.battle.net and keep the
# real secret only in the untracked local/production .env file.
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_BUILD_NUMBER=
BATTLENET_BUILD_VERSION=

# Encrypted PostgreSQL catalog backups. Set one absolute, dedicated server-local
# directory, or leave it empty and configure the R2/S3 alternative below. The
# restore URL is generated per run and must not be stored here.
CATALOG_BACKUP_LOCAL_DIRECTORY=/var/lib/gildra/catalog-backups
CATALOG_BACKUP_S3_ENDPOINT=
CATALOG_BACKUP_S3_REGION=auto
CATALOG_BACKUP_S3_BUCKET=
CATALOG_BACKUP_S3_ACCESS_KEY_ID_FILE=/etc/gildra/catalog-backup/r2-access-key-id
CATALOG_BACKUP_S3_SECRET_ACCESS_KEY_FILE=/etc/gildra/catalog-backup/r2-secret-access-key
CATALOG_BACKUP_S3_PATH_STYLE=true
CATALOG_BACKUP_URI_SCHEME=r2
CATALOG_BACKUP_AGE_RECIPIENT=
CATALOG_BACKUP_AGE_IDENTITY_FILE=/etc/gildra/catalog-backup/age-identity
CATALOG_BACKUP_SIGNING_KEY_FILE=/etc/gildra/catalog-backup/signing-key
CATALOG_BACKUP_OBJECT_PREFIX=catalog-backups
CATALOG_BACKUP_TIMEOUT=2h

# Cloudflare provisioning uses an attributable operator profile containing a
# scoped API token. Broad account credentials are never application runtime
# configuration and must not be stored in this file.

# ParsesUnix providers. Keep real values only in the untracked production .env.
# Paid providers are still disabled unless explicitly listed in a run config.
SCRAPE_DO_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_BROWSER_ZONE=
BRIGHTDATA_CPM_USD=
ZENROWS_API_KEY=
ZENROWS_BASE_CPM_USD=
ZYTE_API_KEY=
ZYTE_HTTP_MAX_USD=
ZYTE_BROWSER_MAX_USD=
ZYTE_CAPTURE_MAX_USD=
FIRECRAWL_API_KEY=

# Production images are injected by CI/CD as immutable commit-SHA tags.
# These placeholders are intentionally non-runnable: never deploy mutable latest tags.
WEB_IMAGE=ghcr.io/gildra-foundation/gildra-web@sha256:replace-with-image-digest
API_IMAGE=ghcr.io/gildra-foundation/gildra-api@sha256:replace-with-image-digest
CMS_IMAGE=ghcr.io/gildra-foundation/gildra-cms@sha256:replace-with-image-digest
SCRAPER_IMAGE=ghcr.io/gildra-foundation/gildra-scraper@sha256:replace-with-image-digest
