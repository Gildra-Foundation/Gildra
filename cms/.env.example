# Shared Payload CMS (gildra.net + riftden.com). Copy to .env; never commit real values.

# --- Core -------------------------------------------------------------------
PAYLOAD_SECRET=                      # long random string (also keys preview tokens)
PAYLOAD_DATABASE_URL=postgres://payload:CHANGE_ME@localhost:5432/payload
PAYLOAD_PUBLIC_URL=http://localhost:3001   # public origin of the CMS/admin
PAYLOAD_DB_PUSH=false                # keep false; schema changes go through migrations
PAYLOAD_MEDIA_DIR=media
POSTGRES_PASSWORD=                   # docker-compose.example.yml only

# --- Jobs (scheduled publishing, site cache invalidation) --------------------
# Run exactly ONE runner: either CMS_JOBS_AUTORUN=true in a single CMS process,
# or the dedicated worker (`npm run jobs:worker` / Docker target `jobs`).
CMS_JOBS_AUTORUN=false
CMS_JOBS_CRON=* * * * *              # in-process runner schedule
CMS_JOBS_INTERVAL_SECONDS=30         # dedicated worker poll interval
CMS_JOBS_LIMIT=25
# Per-site signing secret for POST <site.revalidateUrl>; name = CMS_REVALIDATE_SECRET_<SITE_SLUG>.
CMS_REVALIDATE_SECRET_GILDRA=
CMS_REVALIDATE_SECRET_RIFTDEN=
CMS_REVALIDATE_TIMEOUT_MS=5000

# --- Email (reader verification / password reset) ----------------------------
# smtp | capture (tests only, refused in production) | anything else = disabled.
# Disabled means registration and resets answer 503 "email-not-configured".
EMAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=                         # true for implicit TLS (465); default by port
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Gildra Network
MEMBER_VERIFY_PATH=/reader/verify           # appended to the site's publicUrl
MEMBER_RESET_PATH=/reader/reset-password

# --- Plausible CE Stats API (server-side only) -------------------------------
PLAUSIBLE_URL=                       # e.g. https://plausible.example.net (no trailing slash)
PLAUSIBLE_API_KEY=                   # Stats API key; never sent to browsers
PLAUSIBLE_TIMEOUT_MS=5000
