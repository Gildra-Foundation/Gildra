{
  "name": "@gildra/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "jobs:worker": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/jobs-worker.ts",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "import:articles": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-articles.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-multi-tenant": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cmdk": "1.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.8",
    "nodemailer": "10.0.16",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "undici": "7.29.1",
    "nodemailer": "10.0.16",
    "sass": "1.105.1",
    "vite": "$vite"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
