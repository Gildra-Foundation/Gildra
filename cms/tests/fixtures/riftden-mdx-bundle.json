      "locales": {
        "en": {
          "title": "Building, saving and sharing a RiftDen loadout",
          "summary": "A practical sequence for using the build editor, with clear limits on calculations and browser storage.",
          "content": {
            "root": {
              "type": "root",
              "version": 1,
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "children": [
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Start with a champion and lane",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Open the ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "build editor",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/builds?c=ahri",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": " and choose a champion. Their base stats establish the calculation, while level controls growth. The lane describes the purpose of the build; it does not make the selected items an automatic recommendation.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Choose a primary rune tree and one rune from each row. The secondary tree allows two runes from different ordinary rows. Add shards and summoner spells. After changing a tree, check the selections again to keep them compatible.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Add items and inspect the result",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Starting items and the main item set have separate rows. Review cost, health, defenses and offensive stats. Open the ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "item catalog",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/items",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": " to inspect descriptions and recipes.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "The result is a stat calculation rather than a complete match simulation. It does not reproduce every conditional passive, stack or ability interaction. When comparing two variants, keep the level fixed and change one setting at a time.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Save and share",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "The page URL describes the current configuration. Copy it to open the build in another browser. Check the champion, runes and items after opening a shared link: unknown values are discarded.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Saved builds remain in the local storage of this browser. They are not an account or a cloud backup. Clearing browser data can remove them, so keep important variants as links too. After a patch update, review the item selection and cost; an old configuration need not produce the old result.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Items and runes come from ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "Riot Data Dragon",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "https://developer.riotgames.com/docs/lol#data-dragon",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": " and CommunityDragon. Supported calculations are described on the ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "methods page",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/methodology",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": ".",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                }
              ]
            }
          }
        },
        "ru": {
          "title": "Как собрать и сохранить билд в RiftDen",
          "summary": "Чемпион, руны, предметы и ссылка: последовательность работы с конструктором и ограничения расчётов.",
          "content": {
            "root": {
              "type": "root",
              "version": 1,
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "children": [
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Выберите чемпиона и линию",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Откройте ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "конструктор билдов",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/builds?c=ahri",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": " и начните с чемпиона. Его базовые характеристики задают основу расчёта, а уровень определяет прирост. Линия помогает описать назначение билда; она не превращает выбранные предметы в автоматически рекомендованный набор.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Выберите основное дерево рун и по одной руне из его рядов. В дополнительном дереве выбираются две руны из разных обычных рядов. Затем задайте осколки и заклинания призывателя. Если меняете дерево, проверьте выбор ещё раз: совместимость рун важнее заполненных слотов.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Добавьте предметы и проверьте цифры",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Стартовые предметы и основной набор находятся в отдельных рядах. Наведите внимание на стоимость, здоровье, защиту и атакующие характеристики. Откройте ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "каталог предметов",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/items",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": ", чтобы посмотреть описание эффекта и рецепт.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Числа справа — расчёт характеристик, а не результат полноценной симуляции матча. Конструктор не воспроизводит все условные эффекты предметов, накопление зарядов и взаимодействия умений. Для сравнения двух вариантов сохраняйте одинаковый уровень и меняйте один параметр за раз.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "heading",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Сохранение и передача",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "tag": "h2"
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Ссылка на страницу описывает текущую конфигурацию. Её можно скопировать и открыть в другом браузере. После открытия проверьте чемпиона, руны и предметы: неизвестные значения из ссылки отбрасываются.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Сохранённые билды остаются в локальном хранилище этого браузера. Это не аккаунт и не облачная копия. Очистка данных браузера может удалить список, поэтому важные варианты дополнительно храните как ссылки. После обновления патча пересмотрите предметы и стоимость: прежняя конфигурация не гарантирует прежних результатов.",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                },
                {
                  "type": "paragraph",
                  "version": 1,
                  "direction": "ltr",
                  "format": "",
                  "indent": 0,
                  "children": [
                    {
                      "type": "text",
                      "version": 1,
                      "text": "Источники предметов и рун — ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "Riot Data Dragon",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "https://developer.riotgames.com/docs/lol#data-dragon",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": " и CommunityDragon. Поддерживаемые расчёты описаны в ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
                      "type": "link",
                      "version": 1,
                      "direction": "ltr",
                      "format": "",
                      "indent": 0,
                      "children": [
                        {
                          "type": "text",
                          "version": 1,
                          "text": "методике",
                          "format": 0,
                          "detail": 0,
                          "mode": "normal",
                          "style": ""
                        }
                      ],
                      "fields": {
                        "linkType": "custom",
                        "url": "/methodology",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": ".",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    }
                  ],
                  "textFormat": 0
                }
              ]
            }
          }
        }
      },
      "shared": {
        "category": "beginners",
        "publishedAt": "2026-10-08T00:00:00.000Z",
