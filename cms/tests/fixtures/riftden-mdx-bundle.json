                        "url": "https://developer.riotgames.com/docs/lol#data-dragon",
                        "newTab": false
                      }
                    },
                    {
                      "type": "text",
                      "version": 1,
                      "text": ", дополнительные коэффициенты — из CommunityDragon. Полное описание формул и исключений доступно на странице ",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": ""
                    },
                    {
