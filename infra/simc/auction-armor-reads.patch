+#pragma once
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+
+namespace auction_armor
+{
+enum rating : unsigned { speed = 1, leech = 2, avoidance = 4, all = 7 };
+
+// A request is one native process. Include every initialization thread and
+// profileset in the union. A previously seen bit never needs another atomic.
+inline std::atomic<unsigned> reads{0};
+inline thread_local unsigned seen = std::getenv("GILDRA_ARMOR_READS_FILE") ? 0U : static_cast<unsigned>(all);
+inline thread_local unsigned ignored = 0;
+inline thread_local bool copying_gear = false;
+
+inline void observe(unsigned bit)
+{
+  if ( !( (seen | ignored) & bit ) )
+  {
+    seen |= bit;
+    reads.fetch_or(bit, std::memory_order_relaxed);
+  }
+}
+
+struct report_field
+{
+  unsigned previous;
+  explicit report_field(unsigned bit) : previous(ignored) { ignored |= bit; }
+  ~report_field() { ignored = previous; }
+};
+
+struct copy_gear
+{
+  bool previous = copying_gear;
+  copy_gear() { copying_gear = true; }
+  ~copy_gear() { copying_gear = previous; }
+};
+
+// Called only after the final profileset has finished successfully and before
+// formatting the report, which itself queries all three ratings.
+inline void finish()
+{
+  if ( const char* path = std::getenv("GILDRA_ARMOR_READS_FILE") )
+    if ( auto file = std::fopen(path, "w") )
+    {
+      std::fprintf(file, "%u", reads.load(std::memory_order_relaxed));
+      std::fclose(file);
+    }
+}
+}
