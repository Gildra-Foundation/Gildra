+  const unsigned cap = parsed.content_tuning_id ? static_cast<unsigned>( std::max( 0, tuning.max_level_squish ) ) : 0;
+  const unsigned drop = parsed.drop_level;
+  std::array<unsigned, 4> inputs{};
+  for ( auto id : parsed.bonus_id )
+  {
