+        case ITEM_BONUS_SCALING_2:
+          inputs[ 0 ] = drop;
+          break;
+        case ITEM_BONUS_SCALE_CONFIG:
+          inputs[ 1 ] = drop <= 80 ? drop : 0;
+          inputs[ 2 ] = cap;
+          break;
+        case ITEM_BONUS_SCALE_CONFIG_2:
+          inputs[ 3 ] = cap ? std::min( drop, cap ) : drop;
+          break;
+      }
+    }
+  }
+  auto result = slotnode[ "gildra_scaling_inputs_v1" ];
+  result.make_array();
+  for ( auto input : inputs )
+    result.add() = input;
