+// Pinned 18428cd parses context into DUMMY_CONTEXT. Its only mechanical reads of
+// drop_level/content_tuning are the three handlers in apply_item_bonus. Keep their
+// effective inputs for bare local items. Callers must also match the item ID, all
+// original bonus IDs, slot, and every other mechanically serialized option.
+void gildra_scaling_inputs( JsonOutput slotnode, const item_t& item )
+{
+  const auto& parsed = item.parsed;
+  if ( parsed.data.item_class != ITEM_CLASS_ARMOR || item.parent_slot != SLOT_INVALID ||
+       parsed.enchant_id || parsed.addon_id || !parsed.temporary_enchants.empty() ||
+       parsed.data.id_socket_bonus || !parsed.special_effects.empty() ||
+       range::any_of( parsed.data.effects, []( const auto& e ) { return e.spell_id != 0; } ) ||
+       range::any_of( parsed.data.socket_color, []( auto color ) { return color != 0; } ) ||
+       range::any_of( parsed.gem_id, []( auto id ) { return id != 0; } ) )
+    return;
+
+  const auto& dbc = *item.player->dbc;
+  const auto& tuning = dbc.content_tuning( parsed.content_tuning_id );
+  if ( parsed.content_tuning_id && !tuning.id )
+    return;
+  const unsigned cap = parsed.content_tuning_id ? static_cast<unsigned>( std::max( 0, tuning.max_level_squish ) ) : 0;
+  const unsigned drop = parsed.drop_level;
+  std::array<unsigned, 4> inputs{};
+  for ( auto id : parsed.bonus_id )
+  {
+    const auto entries = dbc.item_bonus( id );
+    if ( entries.empty() )
+      return;
+    for ( const auto& entry : entries )
+    {
+      switch ( entry.type )
+      {
+        case ITEM_BONUS_APPLY_BONUS:
+          return; // Nested lists may introduce additional handlers.
+        case ITEM_BONUS_SCALING_2:
+          inputs[ 0 ] = drop;
+          break;
+        case ITEM_BONUS_SCALE_CONFIG:
+          inputs[ 1 ] = drop <= 80 ? drop : 0;
+          inputs[ 2 ] = cap;
+          break;
+        case ITEM_BONUS_SCALE_CONFIG_2:
+          inputs[ 3 ] = cap ? std::min( drop, cap ) : drop;
+          break;
+      }
+    }
+  }
+  auto result = slotnode[ "gildra_scaling_inputs_v1" ];
+  result.make_array();
+  for ( auto input : inputs )
+    result.add() = input;
+
+  // In the audited revision these early standalone suffix IDs have no numeric
+  // lookup in combat. Only the two stat allocations and suffix are applied.
+  // Retain their ordered unrounded DBC operands, even if a low ilvl rounds
+  // different allocations to the same stat. Raw type-4 cross-item tags fail.
+  if ( parsed.bonus_id.size() != 1 || !parsed.azerite_ids.empty() )
+    return;
+  const int id = parsed.bonus_id.front();
+  if ( id < 1 || id > 500 )
+    return;
+  const auto entries = dbc.item_bonus( id );
+  if ( entries.size() != 3 || entries[ 0 ].type != ITEM_BONUS_MOD ||
+       entries[ 1 ].type != ITEM_BONUS_MOD || entries[ 2 ].type != ITEM_BONUS_SUFFIX )
+    return;
+  auto program = slotnode[ "gildra_suffix_program_v1" ];
+  program.make_array();
+  program.add() = id; // Bound to the request in the worker and omitted from the digest.
+  for ( const auto& row : entries )
+  {
+    program.add() = row.type;
+    program.add() = row.value_1;
+    program.add() = row.value_2;
+    program.add() = row.value_3;
+    program.add() = row.value_4;
+    program.add() = row.index;
+  }
+}
