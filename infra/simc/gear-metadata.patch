+// Pinned decode_stats replaces the two crafting placeholders before accumulating
+// their ratings. Only certify two distinct rows with identical unrounded inputs
+// to scaled_stat. The last array position has special handling in stat_value.
+void gildra_crafted_symmetry( JsonOutput node, const item_t& item )
+{
+  const auto& p = item.parsed;
+  const auto& mods = p.crafted_stat_mod;
+  if ( mods.size() != 2 || mods[ 0 ] == mods[ 1 ] || item.parent_slot != SLOT_INVALID ||
+       p.enchant_id || p.addon_id || !p.temporary_enchants.empty() ||
+       range::any_of( p.gem_id, []( auto id ) { return id != 0; } ) )
+    return;
+  const auto size = p.data.stat_type_e.size();
+  std::array<size_t, 2> index{ size, size };
+  for ( size_t i = 0; i < size; ++i )
+    for ( size_t j = 0; j < index.size(); ++j )
+      if ( p.data.stat_type_e[ i ] == mods[ j ] )
+      {
+        if ( index[ j ] != size || i + 1 == size )
+          return;
+        index[ j ] = i;
+      }
+  const auto a = index[ 0 ], b = index[ 1 ];
+  auto socket_mul = [&]( size_t i ) {
+    return i < p.data._dbc_stats_count ? p.data._dbc_stats[ i ].socket_mul : 0.0f;
+  };
+  if ( a == size || b == size || p.data.stat_alloc[ a ] != p.data.stat_alloc[ b ] ||
+       p.stat_val[ a ] != p.stat_val[ b ] || socket_mul( a ) != socket_mul( b ) )
+    return;
+  auto pair = node[ "gildra_crafted_symmetry_v1" ];
+  pair.make_array();
+  pair.add() = mods[ 0 ];
+  pair.add() = mods[ 1 ];
+}
