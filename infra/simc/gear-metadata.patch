+// The only drop/tuning reader in these bonus lists is one type-51 curve.
+// Equal rounded outputs write the same item level and scaling flag. The other
+// accepted entries add sockets or are ignored by the pinned item parser.
+void gildra_drop_curve( JsonOutput node, const item_t& item )
+{
+  const auto& parsed = item.parsed;
+  if ( !parsed.drop_level || parsed.data.item_class != ITEM_CLASS_ARMOR || item.parent_slot != SLOT_INVALID )
+    return;
+  const auto& dbc = *item.player->dbc;
+  int config_id = 0;
+  for ( auto id : parsed.bonus_id )
+  {
+    auto entries = dbc.item_bonus( id );
+    if ( entries.empty() ) return;
+    for ( const auto& entry : entries )
+    {
+      switch ( entry.type )
+      {
+        case ITEM_BONUS_SCALE_CONFIG_2:
+          if ( config_id || entry.value_1 <= 0 ) return;
+          config_id = entry.value_1;
+          break;
+        case ITEM_BONUS_SOCKET:
+        case 26:
+        case 27:
+        case 47:
+          break;
+        default:
+          return;
+      }
+    }
+  }
+  if ( !config_id ) return;
+  const auto configs = item_scaling_config_data_t::find( config_id, dbc.ptr );
+  if ( configs.empty() ) return;
+  const auto offsets = item_offset_curve_data_t::find( configs[ 0 ].item_offset_curve_id, dbc.ptr );
+  if ( offsets.empty() ) return;
+  auto drop = parsed.drop_level;
+  const auto& tuning = dbc.content_tuning( parsed.content_tuning_id );
+  if ( parsed.content_tuning_id && tuning.id != parsed.content_tuning_id ) return;
+  if ( tuning.max_level_squish > 0 ) drop = std::min( drop, static_cast<unsigned>( tuning.max_level_squish ) );
+  const auto& offset = offsets[ 0 ];
+  const int level = as<int>( util::round( item_database::curve_point_value( dbc, offset.curve_id, drop ) ) ) + offset.offset;
+  if ( level <= 0 || level != as<int>( parsed.data.level ) || !parsed.has_midnight_scaling ) return;
+  auto proof = node[ "gildra_drop_curve_v1" ];
+  proof.make_array();
+  proof.add() = parsed.drop_level;
+  proof.add() = parsed.content_tuning_id;
+  proof.add() = level;
+}
