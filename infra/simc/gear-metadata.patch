+// The worker resolves each variant on its own actor. Keep the usual native
+// initialization and gear serializer, and emit only the fields the worker reads.
+bool gildra_variant_report( JsonOutput node, const sim_t& sim )
+{
+  const char* requested = std::getenv( "GILDRA_VARIANT_REPORT_SLOTS" );
+  if ( !requested || sim.iterations != 1 )
+    return false;
+  const auto names = util::string_split<util::string_view>( requested, "," );
+  if ( names.size() != sim.player_no_pet_list.size() )
+    return false;
+
+  std::vector<slot_e> slots;
+  for ( size_t i = 0; i < names.size(); ++i )
+  {
+    const auto slot = util::parse_slot_type( names[ i ] );
+    if ( slot == SLOT_INVALID || sim.player_no_pet_list[ i ]->name_str != fmt::format( "gildra_variant_{}", i ) )
+      return false;
+    slots.push_back( slot );
+  }
+
+  auto players = node[ "players" ].make_array();
+  for ( size_t i = 0; i < slots.size(); ++i )
+  {
+    const auto* p = sim.player_no_pet_list[ i ];
+    auto actor = players.add();
+    actor[ "name" ] = p->name();
+    gear_to_json( actor[ "gear" ], *p, slots[ i ] );
+  }
+  return true;
+}
