+  if ( parsed.bonus_id.size() != 1 || !parsed.azerite_ids.empty() )
+    return;
+  const int id = parsed.bonus_id.front();
+  if ( id < 1 || id > 500 )
+    return;
+  const auto entries = dbc.item_bonus( id );
+  if ( entries.size() != 3 || entries[ 0 ].type != ITEM_BONUS_MOD ||
+       entries[ 1 ].type != ITEM_BONUS_MOD || entries[ 2 ].type != ITEM_BONUS_SUFFIX )
+    return;
+  auto program = slotnode[ "gildra_suffix_program_v1" ];
+  program.make_array();
