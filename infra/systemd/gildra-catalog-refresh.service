[Unit]
Description=Gildra atomic World of Warcraft catalog refresh
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/gildra/.env
ConditionPathExists=/opt/gildra/current-release.env

[Service]
Type=oneshot
WorkingDirectory=/opt/gildra
ExecCondition=/usr/bin/docker compose --env-file .env --env-file current-release.env -f compose.yml -f compose.prod.yml -f compose.runtime.yml run --rm --no-deps --entrypoint catalog-refresh-all api -mode check -require-update -timeout 2h
ExecStart=/usr/bin/docker compose --env-file .env --env-file current-release.env -f compose.yml -f compose.prod.yml -f compose.runtime.yml run --rm --no-deps --entrypoint catalog-refresh-all api -mode apply -publication-environment production -access-mode private -recovery-policy verified_same_host -timeout 24h
TimeoutStartSec=25h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
