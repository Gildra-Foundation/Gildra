FROM golang:1.26.6-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/staging ./cmd/staging

# Local release artifact; deploy preflight verifies its recorded image ID.
FROM gildra-api:mvp-candidate-20261019
COPY --from=builder /out/staging /usr/local/bin/staging
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/staging"]
