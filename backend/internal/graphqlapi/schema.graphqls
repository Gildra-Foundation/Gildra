scalar JSON
scalar Time

enum Locale {
  en_US
  ru_RU
}

type GameProduct {
  id: Int!
  slug: String!
  name: String!
  buildNumber: Int
  buildVersion: String
  source: String!
  sourceBuildNumber: Int
  sourceBuildVersion: String
  sourceStatus: String
  sourceCheckedAt: Time
  entityCount: Int!
  publishedEntityCount: Int!
  publicRelease: Boolean!
  freshness: String!
  freshnessReason: String!
}

type LibraryDataset {
  slug: String!
  product: String!
  entityType: String!
  categoryPath: String!
  itemClassId: Int
  group: String!
  iconSymbol: String!
  sortOrder: Int!
  name: String!
  description: String!
  buildVersion: String
  previewIconName: String
  previewImageUrl: String
  entityCount: Int!
  localizedCount: Int!
  verifiedLocalizedCount: Int!
  tooltipCount: Int!
  imageCount: Int!
  applicability: String!
  applicabilityReason: String!
  freshness: String!
  freshnessReason: String!
  coverageUpdatedAt: Time
}

type GameEntity {
  id: ID!
  product: String!
  type: String!
  externalId: String!
  slug: String!
  locale: Locale!
  resolvedLocale: Locale!
  localeFallback: Boolean!
  name: String!
  description: String!
  rawDescription: String!
  resolvedDescription: String!
  localizations: [GameEntityLocalization!]!
  tooltip: GameTooltip
  media: [GameEntityMedia!]!
  iconName: String
  iconUrl: String
  quality: Int
  buildId: String
  payload: JSON!
  updatedAt: Time!
}

type GameEntitySummary {
  id: ID!
  product: String!
  type: String!
  externalId: String!
  slug: String!
  name: String!
  iconName: String
  iconUrl: String
}

enum RelationshipDirection {
  both
  incoming
  outgoing
}

type GameEntityRelationship {
  direction: RelationshipDirection!
  relation: String!
  buildId: String!
  attributes: JSON!
  entity: GameEntitySummary!
}

type GameEntityRelationshipConnection {
  nodes: [GameEntityRelationship!]!
  pageInfo: PageInfo!
  total: Int!
}

type GameEntityLocalization {
  locale: Locale!
  name: String!
  description: String!
  resolvedDescription: String!
}

type GameTooltip {
  plainText: String!
  blocks: [JSON!]!
}

type GameEntityMedia {
  kind: String!
  assetKey: String!
  url: String!
  source: String!
  sourceUrl: String!
  locale: String!
  mimeType: String!
  cacheStatus: String!
  fileDataId: String
  width: Int
  height: Int
  primary: Boolean!
}

type PageInfo {
  nextCursor: String
  hasMore: Boolean!
}

type GameEntityConnection {
  nodes: [GameEntity!]!
  pageInfo: PageInfo!
}

type Query {
  gameProducts: [GameProduct!]!
  libraryDatasets(product: String = "wow", locale: Locale = en_US): [LibraryDataset!]!
  gameEntity(id: ID!, locale: Locale = en_US): GameEntity
  gameEntityRelationships(
    id: ID!
    locale: Locale = en_US
    direction: RelationshipDirection = both
    relation: String
    cursor: String
    limit: Int = 50
  ): GameEntityRelationshipConnection!
  gameEntities(
    product: String
    type: String
    locale: Locale = en_US
    query: String
    cursor: String
    limit: Int = 20
  ): GameEntityConnection!
}
